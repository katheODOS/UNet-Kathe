# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual Environment
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints

# Data and Logs
*.log
data/*
!data/.gitkeep
logs/
*.pkl
*.h5

# Ignore PNGs in data directory and all subdirectories
data/**/*.png

# Keep the data directory structure
!data/**/
!data/**/.gitkeep

# OS specific
.DS_Store
Thumbs.db

# Weights & Biases
wandb/
*.wandb
artifacts/

# Ignore .pth checkpoint files but keep all model directories and their structure
*.pth
checkpoints/**/*.pth

# Keep specific result files
!checkpoints/
!checkpoints/**/
!checkpoints/**/output.txt
!checkpoints/**/results/class_accuracies.png
!checkpoints/**/results/confusion_matrix.png
!checkpoints/**/results/evaluation_report.txt

# Explicitly ignore prediction directories
checkpoints/**/results/predictions/
checkpoints/**/results/rgb_predictions/

# Keep validation score files
!checkpoints/validation_scores.json
!checkpoints/validation_scores_sorted.txt
